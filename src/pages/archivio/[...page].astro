---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { allArticles, CATEGORY_LABELS, dateIt, type Article } from "../../lib";
export async function getStaticPaths({ paginate }: { paginate: any }) {
  return paginate(await allArticles(), { pageSize: 30 });
}
const { page } = Astro.props as { page: any };
---
<BaseLayout title="Archivio – Ltalia Online">
  <div class="wrap">
    <div class="sez" style="margin-top:0"><h2>Archivio</h2></div>
    <div class="lista">
      {page.data.map((a: Article) => (
        <a href={`/articoli/${a.id}/`}><time>{dateIt(a.data.published_at)}</time><span class="tag">{CATEGORY_LABELS[a.data.category]}</span> {a.data.title}</a>
      ))}
    </div>
    <div class="pager"><span>{page.url.prev && <a href={page.url.prev}>← Più recenti</a>}</span><span>{page.url.next && <a href={page.url.next}>Più vecchie →</a>}</span></div>
  </div>
</BaseLayout>
